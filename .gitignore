# ===========================================
# LWM-RIS .gitignore (CodeIgniter 4 Project)
# ===========================================

# ----- Operating System Files -----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- Editor / IDE -----
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ----- PHP / Composer -----
/vendor/
composer.phar

# ----- Environment Files (Sensitive) -----
.env
.env.*
!.env.example

# ----- PHPUnit / Testing -----
.phpunit.result.cache
/coverage/
coverage.xml

# ----- Node / JavaScript -----
node_modules/
npm-debug.log*
yarn-error.log

# ----- CodeIgniter Writable Folder -----
/writable/cache/*
/writable/logs/*
/writable/session/*
/writable/debugbar/*
/writable/uploads/*
!/writable/.gitkeep
!/writable/*/.gitkeep

# ----- User Uploads -----
/uploads/*
!/uploads/.gitkeep

# ----- Database Files -----
*.sqlite
*.sqlite3
*.db

# ----- Temp / Backup Files -----
*~
*.swp
*.swo
*.bak
*.BAK
*.tmp
*.log

# ----- Distribution / Build -----
/dist/
/build/
/bin/

# ----- Temporary Export Folders -----
DBExportTemp*/
*TempForAi/

# End of .gitignore
